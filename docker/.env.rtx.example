# Separate from the Jetson .env configuration.
RTX_IMAGE=liquid-audio-rtx:local
RTX_BASE_IMAGE=python:3.12-slim-bookworm
RTX_GPU_ID=0

# Use the RTX machine's LAN IP for remote browser access (no scheme or port).
# localhost is suitable when the browser runs on the RTX machine itself.
RTX_HTTPS_HOST=localhost
HF_TOKEN=
