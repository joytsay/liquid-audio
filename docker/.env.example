# Optional overrides; Compose builds this image locally by default.
LIQUID_AUDIO_IMAGE=liquid-audio-agx:local
BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
# Parallel compiler jobs for PyTorch/torchaudio; reduce to 1 if memory is tight.
MAX_JOBS=2

# localhost uses Caddy's local CA; set a real DNS name for public HTTPS.
SITE_ADDRESS=localhost
